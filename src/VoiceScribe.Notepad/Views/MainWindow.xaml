<Window x:Class="VoiceScribe.Notepad.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:models="using:VoiceScribe.Notepad.Models" Title="VoiceScribe">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <MenuBar>
   <MenuBarItem Title="Archivo">
    <MenuFlyoutItem x:Name="NewMenu" Text="Nueva sesión" Click="NewSession_Click"/>
    <MenuFlyoutItem Text="Guardar" Click="Save_Click"/>
    <MenuFlyoutItem Text="Abrir carpeta de notas" Click="OpenFolder_Click"/>
   </MenuBarItem>
   <MenuBarItem Title="Herramientas"><MenuFlyoutItem x:Name="SettingsMenu" Text="Configuración" Click="Settings_Click"/></MenuBarItem>
  </MenuBar>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Padding="16">
    <Grid RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel Spacing="4"><TextBlock Text="VoiceScribe" Style="{ThemeResource TitleTextBlockStyle}"/><TextBlock Text="Tu cuaderno de dictado" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
     <Button x:Name="NewButton" Grid.Row="1" HorizontalAlignment="Stretch" Click="NewSession_Click">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE710;" FontSize="14"/><TextBlock Text="Nueva sesión"/></StackPanel>
     </Button>
     <ListView x:Name="SessionList" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Sessions}" SelectionChanged="SessionList_SelectionChanged" SelectionMode="Single">
      <ListView.ItemTemplate><DataTemplate x:DataType="models:NoteSession">
       <StackPanel Padding="0,8" Spacing="4"><TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{x:Bind DateLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
      </DataTemplate></ListView.ItemTemplate>
     </ListView>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Padding="32,24" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="TitleEditor" PlaceholderText="Título de la sesión" FontSize="24" FontWeight="SemiBold" TextChanged="TitleEditor_TextChanged" AutomationProperties.Name="Título de la sesión"/>
    <TextBlock Grid.Row="1" Text="Escribe o dicta. Tus notas se guardan automáticamente como Markdown." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
    <TextBox x:Name="Editor" Grid.Row="2" AcceptsReturn="True" TextWrapping="Wrap" FontSize="18" Padding="20" VerticalContentAlignment="Top" TextChanged="Editor_TextChanged" PlaceholderText="Empieza una idea…" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Contenido de la nota"/>
    <Grid Grid.Row="3" ColumnSpacing="16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button x:Name="DictateButton" Style="{ThemeResource AccentButtonStyle}" Click="Dictate_Click" Padding="20,12">
      <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE720;" FontSize="18"/><TextBlock x:Name="DictateLabel" Text="Iniciar dictado"/></StackPanel>
     </Button>
     <TextBlock x:Name="StateText" Grid.Column="1" Text="Listo para escribir" VerticalAlignment="Center" TextWrapping="Wrap"/>
     <ProgressRing x:Name="BusyRing" Grid.Column="2" Width="24" Height="24" IsActive="False"/>
    </Grid>
   </Grid>
  </Grid>
  <Border Grid.Row="2" Padding="16,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="SaveState" Text="" FontSize="12" TextTrimming="CharacterEllipsis"/>
    <TextBlock Grid.Column="1" Text="ASR local · Markdown" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
   </Grid>
  </Border>
 </Grid>
</Window>
